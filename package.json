{
  "name": "@hassanhabib/standard-agents",
  "version": "0.3.0",
  "description": "A TypeScript implementation of The Standard for Agents: Agent = Orchestration(Data, Decision, Direction).",
  "author": {
    "name": "Hassan Habib",
    "email": "hassan@bestbytes.ai"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://github.com/hassanhabib/standard-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hassanhabib/standard-agents.git"
  },
  "bugs": {
    "url": "https://github.com/hassanhabib/standard-agents/issues"
  },
  "keywords": [
    "the-standard",
    "agents",
    "agent",
    "tri-nature",
    "ai",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*Tests*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "npm run clean && npm run build",
    "conformance": "npm run build && tsc -p conformance && node conformance/dist/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
